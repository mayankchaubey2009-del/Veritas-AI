# VERITAS AI — Backend Environment Configuration (Phase 6 Production Readiness)
APP_NAME="VERITAS AI Forensic Intelligence Engine"
APP_VERSION="2.0.0-phase6"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (comma-separated, explicit allowlist required for credentials)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database & Backup Configuration (SQLite WAL + Online Backup)
DATABASE_PATH="./data/veritas_forensics.db"
BACKUP_DIR="./data/backups"

# Document Storage & Upload Security (Strictly outside frontend/public)
STORAGE_DIR="./storage/documents"
MAX_UPLOAD_SIZE_MB=25
MAX_TOTAL_UPLOAD_SIZE_MB=100
MAX_FILES_PER_UPLOAD=10
MAX_PDF_PAGES=200
MAX_IMAGE_PIXELS=50000000
NATIVE_PDF_MIN_CHARS_PER_PAGE=15

# Authentication, Session Security & Rate Limiting (Module A)
AUTH_ENFORCED=true
ENABLE_DEMO_PERSONA_SWITCHING=true
SESSION_COOKIE_NAME="veritas_session"
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE="lax"
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
INITIAL_ADMIN_USERNAME="p.nair"
INITIAL_ADMIN_PASSWORD=""

# AI & Forensic Integrations (Server-Side Only — Never expose to Frontend)
GEMINI_API_KEY=""
ENABLE_OCR_PIPELINE=true
ENABLE_CV_FORENSICS=true
ENABLE_GEMINI_REASONING=true
